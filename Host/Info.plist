	<array>
		<string>_tafel._tcp</string>
		<string>_tafelpair._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tafel nimmt Verbindungen von deinem gekoppelten iPad im lokalen Netzwerk an.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Tafel überträgt den gewählten Bildschirmbereich auf dein iPad.</string>
